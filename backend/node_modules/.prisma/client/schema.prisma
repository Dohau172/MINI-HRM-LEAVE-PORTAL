generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  DIRECTOR
  HR
  ADMIN
}

enum ContractType {
  PROBATION // Thử việc (chỉ được xin nghỉ không lương)
  OFFICIAL // Chính thức (hưởng đầy đủ các chế độ)
}

enum LeaveType {
  ANNUAL // Phép năm
  SICK // Nghỉ ốm
  UNPAID // Nghỉ không lương
  MATERNITY // Nghỉ thai sản
  WEDDING_BEREAVEMENT // Cưới / Tang (việc riêng có hưởng lương)
}

enum LeaveUnit {
  FULL_DAY // Cả ngày (1.0)
  MORNING // Nửa ngày sáng (0.5)
  AFTERNOON // Nửa ngày chiều (0.5)
}

enum LeaveStatus {
  PENDING // CHỜ DUYỆT (Cấp 1 - Quản lý trực tiếp)
  PENDING_DIRECTOR // CHỜ GIÁM ĐỐC DUYỆT (Cấp 2 - Đơn >= 3 ngày)
  APPROVED // ĐÃ DUYỆT
  REJECTED // ĐÃ TỪ CHỐI
  CANCEL_REQUESTED // CHỜ XÁC NHẬN HỦY (Đơn đã duyệt xin hủy)
  CANCELLED // ĐÃ HỦY
}

model User {
  id                String       @id @default(uuid())
  fullName          String
  email             String       @unique
  password          String
  role              Role         @default(EMPLOYEE)
  contractType      ContractType @default(OFFICIAL)
  position          String       @default("Nhân viên") // Chức danh: Kỹ sư phần mềm, Trưởng phòng, Giám đốc...
  department        String // Phòng ban: Kỹ thuật, Nhân sự, Kinh doanh...
  canApprove        Boolean      @default(false) // Thẩm quyền phê duyệt đơn
  annualLeaveQuota  Float        @default(12.0) // Quỹ phép năm hiện tại
  previousYearQuota Float        @default(0.0) // Phép tồn năm cũ (hạn đến 31/03)
  seniorityYears    Int          @default(0) // Số năm thâm niên làm việc
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  leaveRequests    LeaveRequest[] @relation("UserLeaveRequests")
  approvedRequests LeaveRequest[] @relation("ApprovedByRequests")

  delegationsFrom Delegation[] @relation("Delegator")
  delegationsTo   Delegation[] @relation("Delegatee")

  auditLogsCreated  AuditLog[] @relation("AdminAuditLogs")
  auditLogsReceived AuditLog[] @relation("TargetUserAuditLogs")

  @@map("users")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  leaveUnit     LeaveUnit   @default(FULL_DAY)
  startDate     DateTime
  endDate       DateTime
  workingDays   Float
  reason        String
  attachmentUrl String?
  status        LeaveStatus @default(PENDING)
  rejectReason  String?

  approvalLevel  Int     @default(1) // 1: Cần 1 cấp; 2: Cần 2 cấp (đơn >= 3 ngày)
  approvedById   String?
  approvedBy     User?   @relation("ApprovedByRequests", fields: [approvedById], references: [id])
  isDelegated    Boolean @default(false) // Được duyệt qua cơ chế ủy quyền DoA
  delegationNote String? // Ghi chú ủy quyền nếu có

  cancelReason String? // Lý do khi tạo yêu cầu hủy đơn đã duyệt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("leave_requests")
}

model Delegation {
  id          String   @id @default(uuid())
  delegatorId String // Quản lý A
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateeId String // Quản lý B (người nhận ủy quyền)
  delegatee   User     @relation("Delegatee", fields: [delegateeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delegations")
}

model PublicHoliday {
  id          String   @id @default(uuid())
  name        String // Tên ngày lễ: Tết Nguyên Đán, Giỗ Tổ 10/3, 30/4 - 1/5...
  date        DateTime @unique
  description String?
  createdAt   DateTime @default(now())

  @@map("public_holidays")
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("TargetUserAuditLogs", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       String // ADJUST_QUOTA, CHANGE_ROLE, CHANGE_CONTRACT...
  oldValue     String
  newValue     String
  reason       String // Bắt buộc nhập lý do can thiệp
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model PayrollPeriod {
  id        String    @id @default(uuid())
  monthYear String    @unique // Ví dụ: "10/2026"
  startDate DateTime // Ngày 26 tháng trước
  endDate   DateTime // Ngày 25 tháng hiện tại
  isLocked  Boolean   @default(false) // Khóa sổ kỳ tính lương
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("payroll_periods")
}
